# config.py
# Mutable Baseline for the Search / agents. ENGINE_* = performance;
# SAMPLER_* = quality. program.md and evaluation harnesses are fixed.
# .autoresearch_state.json stores visited memory only (not Baseline).
# NOTE: CTX_SIZE default is 131072. User may lower it to trade context for speed.
# Minimum floor is 2048 (llama.cpp practical minimum).
#
# This file is gitignored. Seed from the tracked template:
#   cp autoresearch/core/config.py.example autoresearch/core/config.py

import math
import os
import re
import tempfile
from pathlib import Path
from typing import Any

from autoresearch.core.circuit_breaker import (
    DEFAULT_FLOOR_MB,
    DEFAULT_POLL_S,
    DEFAULT_PREFLIGHT_MARGIN_MB,
    DEFAULT_RESERVE_MB,
)
from autoresearch.core.model_arch import is_dense_model


class ConfigError(ValueError):
    """Custom exception raised for invalid or unsupported configurations."""
    pass


CONFIG_PATH = Path(__file__).resolve()

# Hardware/Engine/Inference configuration parameters (affect speed and VRAM usage)
# For CPU-only inference: set N_GPU_LAYERS = 0 (and tune THREADS for physical CPU cores).
ENGINE_DEFAULTS = {
    'MODEL': 'model.gguf',
    'CTX_SIZE': 131072,
    # GPU/CPU split: -1 = Auto (let the harness choose), 0 = CPU-only, N>0 = N layers on GPU.
    'N_GPU_LAYERS': -1,
    # NUMA bind mode: None (off), 'distribute', or 'isolate' (llama.cpp --numa).
    'NUMA': None,
    'KV_CACHE': 'q4_0',
    'KV_CACHE_K': 'q4_0',
    'KV_CACHE_V': 'q4_0',
    'BATCH_SIZE': 512,
    'UBATCH_SIZE': 128,
    'THREADS': 8,
    'THREADS_BATCH': 8,
    'FLASH_ATTN': 'on',
    'SPEC_TYPE': None,
    'SPEC_DRAFT_N_MAX': 0,
    'SPEC_DRAFT_MODEL': None,
    # codacus-fork only (not in upstream b10549 common args): expert-cache trace
    # CSV (repo-relative) + slot count. Both None → no --moe-cache-* flags.
    'MOE_CACHE_PROFILE': None,
    'MOE_CACHE_SLOTS': None,
    'NO_MMAP': False,
    'JINJA': True,
    'REASONING_BUDGET': None,
    'REASONING_BUDGET_MESSAGE': None,
    'REASONING': None,
    # None = omit llama.cpp flag (template default). True/False = --reasoning-preserve / --no-reasoning-preserve.
    # Seed True only when GET /props chat_template_caps.supports_preserve_reasoning and the card wants it for agentic.
    # Not a Search neighbor.
    'REASONING_PRESERVE': None,
    # None = omit llama.cpp flag (template default). Only templates that READ
    # reasoning_effort react (verified 2026-08-29: Qwen3.8-27B open-source
    # ladder is xhigh (default) / medium / low, 'high' aliases xhigh, anything
    # else raises in Jinja; qwen35-family templates ignore the variable ->
    # silent no-op). Verify per GGUF via gguf_dump.py --no-tensors before
    # seeding. Not a Search neighbor.
    'REASONING_EFFORT': None,
    'CONT_BATCHING': False,
    'CACHE_REUSE': 256,
    # MoE: None = auto --n-cpu-moe {GGUF block_count}; 0 = full GPU; N>0 = manual.
    'N_CPU_MOE': None,
    'VRAM_LIMIT_MB': 7900,
    # Dynamic Trial headroom (issue #10): effective budget = free VRAM at start
    # minus this margin (MiB). None = default 512. Override via env
    # AUTORESEARCH_VRAM_HEADROOM_MB. Dirty-GPU Trials fail early, not spuriously.
    'VRAM_HEADROOM_MB': None,
    # Optional host-memory preflight reserve (MiB). None = auto from hardware class.
    # Override also via env AUTORESEARCH_HOST_HEADROOM_MB.
    'HOST_MEMORY_HEADROOM_MB': None,
    # Permanent RAM circuit breaker (autoresearch/core/circuit_breaker.py):
    # kills any llama process tree when free RAM < FREE_RAM_FLOOR_MB or its
    # working set > physical - RAM_WATCHDOG_RESERVE_MB. Always on.
    'FREE_RAM_FLOOR_MB': DEFAULT_FLOOR_MB,
    'RAM_WATCHDOG_POLL_S': DEFAULT_POLL_S,
    'RAM_WATCHDOG_RESERVE_MB': DEFAULT_RESERVE_MB,
    # Launch gate only (small): the runtime watchdog enforces FREE_RAM_FLOOR_MB.
    'RAM_PREFLIGHT_MARGIN_MB': DEFAULT_PREFLIGHT_MARGIN_MB,
    # Min tg t/s for Trial reject gate. MoE on 8GB often lands 15–19 — lower per model if needed.
    'TPS_FLOOR': 20.0,
    # llama-cli / SGLang bench: median of this many generations after GPU cooldown.
    'TPS_REPS': 3,
    # Wait for GPU near captured idle temp before each bench / server spawn.
    'THERMAL_WAIT': True,
}
# Generation/Sampling — seed from the model card "Recommended settings"
# for the job (agentic/general vs coding) BEFORE the first Trial. When the
# card has no "Recommended settings" section, seed from
# UNIVERSAL_FALLBACK_SAMPLER below (never the template values).
# llama.cpp server defaults — neutral start for agentic/general jobs; a real
# card's Recommended settings always win when present.
UNIVERSAL_FALLBACK_SAMPLER = {
    'TEMP': 0.8,
    'TOP_P': 0.95,
    'TOP_K': 40,
    'MIN_P': 0.05,
    'REPEAT_PENALTY': 1.0,
    'PRESENCE_PENALTY': 0.0,
    'FREQUENCY_PENALTY': None,
}

SAMPLER_DEFAULTS = {
    'TEMP': 0.8,
    'TOP_P': 0.95,
    'TOP_K': 40,
    'MIN_P': 0.05,
    'REPEAT_PENALTY': 1.0,
    'PRESENCE_PENALTY': 0.0,
    'FREQUENCY_PENALTY': None,
}

# Live Baseline registry (kept in sync when ENGINE_/SAMPLER_ mutate)
DEFAULTS = {**ENGINE_DEFAULTS, **SAMPLER_DEFAULTS}

MIN_CTX_SIZE = 2048

# Architecture class (MoE vs dense): GGUF metadata via model_arch — not filenames.
# MoE N_CPU_MOE=None → harness auto-uses GGUF block_count (see resolve_n_cpu_moe).


def validate_config(cfg: dict) -> dict:
    """Return a normalized copy, or fail before any model process starts."""
    normalized = dict(cfg)
    ctx = int(normalized.get("ctx_size", normalized.get("CTX_SIZE", DEFAULTS["CTX_SIZE"])))
    flash = normalized.get("flash_attn", normalized.get("FLASH_ATTN", DEFAULTS["FLASH_ATTN"]))
    if ctx < MIN_CTX_SIZE:
        raise ConfigError(f"CTX_SIZE must be >= {MIN_CTX_SIZE}; got {ctx}")
    if flash != "on":
        raise ConfigError("FLASH_ATTN must be 'on'")
    batch = int(normalized.get("batch_size", normalized.get("BATCH_SIZE", DEFAULTS["BATCH_SIZE"])))
    ubatch = int(normalized.get("ubatch_size", normalized.get("UBATCH_SIZE", DEFAULTS["UBATCH_SIZE"])))
    if batch <= 0 or ubatch <= 0 or ubatch > batch:
        raise ConfigError("Require BATCH_SIZE > 0 and 0 < UBATCH_SIZE <= BATCH_SIZE")
    model_name = str(normalized.get("model", normalized.get("MODEL", DEFAULTS.get("MODEL", ""))))
    n_cpu_moe = normalized.get("n_cpu_moe", normalized.get("N_CPU_MOE"))
    if n_cpu_moe is not None and is_dense_model(model_name):
        raise ConfigError(
            f"N_CPU_MOE is MoE-only; dense model {model_name!r} must fit physical VRAM "
            "(cut CTX/KV/draft) — never expert/layer offload"
        )
    vram_limit = normalized.get("vram_limit_mb", normalized.get("VRAM_LIMIT_MB", DEFAULTS.get("VRAM_LIMIT_MB", 7900)))
    if vram_limit is not None:
        vram_limit = float(vram_limit)
        if not math.isfinite(vram_limit) or vram_limit <= 0:
            raise ConfigError(f"VRAM_LIMIT_MB must be a positive finite number; got {vram_limit}")
    tps_floor = normalized.get("tps_floor", normalized.get("TPS_FLOOR", DEFAULTS.get("TPS_FLOOR", 20.0)))
    if tps_floor is None:
        tps_floor = 20.0
    tps_floor = float(tps_floor)
    if not math.isfinite(tps_floor) or tps_floor <= 0:
        raise ConfigError(f"TPS_FLOOR must be a positive finite number; got {tps_floor}")
    reasoning_preserve = normalized.get(
        "reasoning_preserve",
        normalized.get("REASONING_PRESERVE", DEFAULTS.get("REASONING_PRESERVE")),
    )
    if reasoning_preserve is not None and not isinstance(reasoning_preserve, bool):
        raise ConfigError(
            f"REASONING_PRESERVE must be True, False, or None; got {reasoning_preserve!r}"
        )
    reasoning_effort = normalized.get(
        "reasoning_effort",
        normalized.get("REASONING_EFFORT", DEFAULTS.get("REASONING_EFFORT")),
    )
    if reasoning_effort is not None:
        if isinstance(reasoning_effort, str):
            reasoning_effort = reasoning_effort.lower()
            normalized["reasoning_effort"] = reasoning_effort
        if reasoning_effort not in (
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "fast",
            "faster",
        ):
            raise ConfigError(
                f"REASONING_EFFORT must be none/minimal/low/medium/high/xhigh/max/fast/faster or None; got {reasoning_effort!r}"
            )
    n_gpu_layers = normalized.get("n_gpu_layers", normalized.get("N_GPU_LAYERS", DEFAULTS.get("N_GPU_LAYERS", -1)))
    if isinstance(n_gpu_layers, bool) or not isinstance(n_gpu_layers, int):
        raise ConfigError(
            f"N_GPU_LAYERS must be -1 (Auto), 0 (CPU-only), or a positive int; got {n_gpu_layers!r}"
        )
    if n_gpu_layers < -1:
        raise ConfigError(
            f"N_GPU_LAYERS must be -1 (Auto), 0 (CPU-only), or a positive int; got {n_gpu_layers}"
        )
    numa = normalized.get("numa", normalized.get("NUMA", DEFAULTS.get("NUMA")))
    if numa is not None and numa not in ("distribute", "isolate"):
        raise ConfigError(f"NUMA must be None, 'distribute', or 'isolate'; got {numa!r}")
    cache_reuse = normalized.get("cache_reuse", normalized.get("CACHE_REUSE", DEFAULTS.get("CACHE_REUSE", 256)))
    if cache_reuse is not None:
        try:
            cache_reuse = int(cache_reuse)
        except (TypeError, ValueError):
            raise ConfigError(f"CACHE_REUSE must be an int >= 0; got {cache_reuse!r}")
        if cache_reuse < 0:
            raise ConfigError(f"CACHE_REUSE must be >= 0; got {cache_reuse}")
    for key, value in normalized.items():
        if isinstance(value, float) and not math.isfinite(value):
            raise ConfigError(f"{key} must be finite")
    normalized["CTX_SIZE"] = ctx
    normalized["FLASH_ATTN"] = flash
    if vram_limit is not None:
        normalized["VRAM_LIMIT_MB"] = vram_limit
    normalized["TPS_FLOOR"] = tps_floor
    normalized["REASONING_PRESERVE"] = reasoning_preserve
    normalized["REASONING_EFFORT"] = reasoning_effort
    normalized["N_GPU_LAYERS"] = n_gpu_layers
    normalized["NUMA"] = numa
    normalized["CACHE_REUSE"] = cache_reuse if cache_reuse is not None else DEFAULTS.get("CACHE_REUSE", 256)
    return normalized

STATE_SCHEMA_VERSION = 3
STATE_FILE = Path(__file__).resolve().parents[2] / ".autoresearch_state.json"

# Derived dynamically from DEFAULTS keys (replaces static CONFIG_KEYS tuple)
CONFIG_KEYS = tuple(DEFAULTS.keys())


def __getattr__(name: str) -> Any:
    """Expose variables from DEFAULTS dynamically for backwards compatibility."""
    if name in DEFAULTS:
        return DEFAULTS[name]
    raise AttributeError(f"module '{__name__}' has no attribute '{name}'")


def __dir__() -> list[str]:
    """Expose all names in DEFAULTS for dynamic directory lookups."""
    return sorted(list(globals().keys()) + list(DEFAULTS.keys()))


def load_config(params: list[str] | None = None) -> dict[str, Any]:
    """Return current Baseline configuration as a dictionary."""
    if params is not None:
        return {p: DEFAULTS.get(p) for p in params if p in DEFAULTS}
    return dict(DEFAULTS)


def _py_literal(value: Any) -> str:
    if value is None:
        return "None"
    if isinstance(value, bool):
        return "True" if value else "False"
    if isinstance(value, str):
        return repr(value)
    return repr(value)


def _format_defaults_dict(name: str, data: dict[str, Any]) -> str:
    lines = [f"{name} = {{"]
    for key, value in data.items():
        lines.append(f"    {key!r}: {_py_literal(value)},")
    lines.append("}")
    return "\n".join(lines)


def _refresh_defaults() -> None:
    DEFAULTS.clear()
    DEFAULTS.update({**ENGINE_DEFAULTS, **SAMPLER_DEFAULTS})


def write_baseline(cfg: dict[str, Any], path: Path | str | None = None) -> dict[str, Any]:
    """Persist Baseline into ENGINE_DEFAULTS / SAMPLER_DEFAULTS (memory + config.py)."""
    target = Path(path) if path is not None else CONFIG_PATH
    merged = dict(DEFAULTS)
    for key in CONFIG_KEYS:
        if key in cfg:
            merged[key] = cfg[key]
    validated = validate_config(merged)

    for key in list(ENGINE_DEFAULTS):
        ENGINE_DEFAULTS[key] = validated[key]
    for key in list(SAMPLER_DEFAULTS):
        SAMPLER_DEFAULTS[key] = validated[key]
    _refresh_defaults()

    text = target.read_text(encoding="utf-8")
    engine_block = _format_defaults_dict("ENGINE_DEFAULTS", ENGINE_DEFAULTS)
    sampler_block = _format_defaults_dict("SAMPLER_DEFAULTS", SAMPLER_DEFAULTS)
    text, n_engine = re.subn(
        r"ENGINE_DEFAULTS\s*=\s*\{.*?\n\}",
        engine_block,
        text,
        count=1,
        flags=re.DOTALL,
    )
    text, n_sampler = re.subn(
        r"SAMPLER_DEFAULTS\s*=\s*\{.*?\n\}",
        sampler_block,
        text,
        count=1,
        flags=re.DOTALL,
    )
    if n_engine != 1 or n_sampler != 1:
        raise ConfigError(
            f"failed to locate defaults blocks in {target} "
            f"(engine={n_engine}, sampler={n_sampler})"
        )

    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=".config.", suffix=".py", dir=target.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            if not text.endswith("\n"):
                handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, target)
    finally:
        if os.path.exists(tmp_name):
            try:
                os.unlink(tmp_name)
            except OSError:
                pass
    return dict(DEFAULTS)
